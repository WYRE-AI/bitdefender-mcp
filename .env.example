# Bitdefender GravityZone API key, generated in Control Center -> My Account
# -> API keys. The key must have the Network, Policies, Reports, and
# Incidents APIs selected at generation time (see README's Authentication
# section) - Bitdefender's own key-generation UI only gates access at the
# API-area level, not per-method, so this connector's read-only posture is
# enforced entirely by its own code (see README's Scope section).
BITDEFENDER_API_KEY=

# The Control Center Access URL shown under My Account -> Control Center API
# (e.g. https://cloud.gravityzone.bitdefender.com for GravityZone Cloud, or
# your own on-premise Control Center's base URL). This connector targets
# only the JSON-RPC APIs published at <BITDEFENDER_ACCESS_URL>/v1.0/jsonrpc/*.
BITDEFENDER_ACCESS_URL=

# HTTP transport only (MCP_TRANSPORT=http): REQUIRED. The server refuses to
# start without a real secret (generate with `openssl rand -hex 32`);
# placeholders are refused too. Local dev only: MCP_ALLOW_INSECURE_DEV=1 skips
# this check and restricts the server to loopback.
# CONDUIT_S2S_SECRET=
# MCP_ALLOW_INSECURE_DEV=
